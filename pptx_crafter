<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>گافا (Gafa) - سازنده هوشمند پاورپوینت</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- کتابخانه PptxGenJS -->
    <script src="https://cdn.jsdelivr.net/npm/pptxgenjs@3.12.0/dist/pptxgen.bundle.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Vazirmatn', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between">

    <!-- هدر -->
    <header class="p-6 border-b border-slate-800 flex justify-between items-center max-w-5xl mx-auto w-full">
        <div class="flex items-center gap-3">
            <span class="bg-gradient-to-r from-indigo-500 to-purple-500 text-white p-2.5 rounded-2xl font-bold shadow-lg shadow-indigo-500/20">🚀 گافا</span>
            <span class="text-xl font-extrabold tracking-wide">Gafa AI Studio</span>
        </div>
        <span class="text-xs bg-indigo-500/10 text-indigo-400 px-3.5 py-1.5 rounded-full border border-indigo-500/20">متصل به هوش مصنوعی ۳.۵</span>
    </header>

    <!-- محتوای اصلی -->
    <main class="max-w-3xl mx-auto px-4 py-12 w-full">
        <div class="text-center mb-10">
            <h1 class="text-3xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
                هوش مصنوعی گافا؛ خالق ارائه‌های حرفه‌ای
            </h1>
            <p class="text-slate-400 text-sm md:text-base">
                موضوع ارائه‌ات رو بنویس تا هوش مصنوعی متن‌ها رو تولید کنه و فایل `.pptx` با جزئیات کامل تحویلت بده.
            </p>
        </div>

        <!-- پنل تنظیمات -->
        <div class="bg-slate-900 p-6 rounded-3xl border border-slate-800 shadow-2xl flex flex-col gap-6">
            
            <!-- کلید API -->
            <div>
                <label class="block text-sm font-semibold text-slate-300 mb-2">کلید API گوگل جمینای (Gemini API Key):</label>
                <input type="password" id="apiKeyInput" 
                    class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition text-sm"
                    placeholder="کلید خود را اینجا وارد کنید (AIzaSy...)">
                <p class="text-xs text-slate-500 mt-1">
                    کلید رایگان را می‌توانید از <a href="https://aistudio.google.com/" target="_blank" class="text-indigo-400 underline">Google AI Studio</a> دریافت کنید.
                </p>
            </div>

            <!-- موضوع -->
            <div>
                <label class="block text-sm font-semibold text-slate-300 mb-2">موضوع یا پرامپت ارائه:</label>
                <textarea id="topicInput" rows="3" 
                    class="w-full bg-slate-950 border border-slate-800 rounded-2xl p-4 text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition resize-none text-sm"
                    placeholder="مثال: تاریخچه هوش مصنوعی، کاربرد فناوری بلاک‌چین..."></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-300 mb-2">تعداد اسلایدها:</label>
                    <select id="slideCount" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-200 text-sm focus:outline-none focus:border-indigo-500">
                        <option value="3">۳ اسلاید</option>
                        <option value="5" selected>۵ اسلاید</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-300 mb-2">تم رنگی ارائه:</label>
                    <select id="themeStyle" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-200 text-sm focus:outline-none focus:border-indigo-500">
                        <option value="dark">تیره مدرن (Dark Sleek)</option>
                        <option value="light">روشن شرکتی (Clean White)</option>
                        <option value="colorful">آبی بنفش تکنولوژی (Tech Glow)</option>
                    </select>
                </div>
            </div>

            <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-4 border-t border-slate-800/80">
                <span id="statusText" class="text-xs text-slate-400">آماده برای ساخت ✨</span>
                <button onclick="generateAIPresentation()" id="generateBtn"
                    class="w-full md:w-auto bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold px-8 py-3 rounded-2xl transition duration-200 text-sm shadow-lg shadow-indigo-600/30">
                    ساخت پاورپوینت با هوش مصنوعی
                </button>
            </div>
        </div>
    </main>

    <!-- فوتر -->
    <footer class="text-center p-6 text-slate-600 text-xs border-t border-slate-900">
        توسعه داده شده در پروژه منبع‌باز «گافا» (Gafa) 🇮🇷
    </footer>

    <script>
        async function generateAIPresentation() {
            const apiKey = document.getElementById('apiKeyInput').value.trim();
            const topic = document.getElementById('topicInput').value.trim();
            const slideCount = parseInt(document.getElementById('slideCount').value);
            const themeStyle = document.getElementById('themeStyle').value;
            const statusText = document.getElementById('statusText');
            const btn = document.getElementById('generateBtn');

            if (!apiKey) {
                alert('لطفاً کلید API جمینای را وارد کنید!');
                return;
            }
            if (!topic) {
                alert('لطفاً موضوع ارائه را وارد کنید!');
                return;
            }

            if (typeof PptxGenJS === 'undefined') {
                alert('خطا: کتابخانه پاورپوینت هنوز بارگذاری نشده است. اتصال اینترنت خود را بررسی کنید.');
                return;
            }

            btn.disabled = true;
            statusText.textContent = 'در حال ارتباط با هوش مصنوعی مدل ۳.۵... 🤖';

            const prompt = `You are a professional presentation creator. For the topic "${topic}", generate a JSON response containing ${slideCount} slides. 
            The JSON format must be strictly an array of objects, where each object has:
            - "title": string (slide title in Persian)
            - "subtitle": string (brief description or subtitle in Persian)
            - "points": array of 3 strings (three key bullet points in Persian)
            Return ONLY valid JSON, no markdown formatting like \`\`\`json.`;

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: prompt }] }]
                    })
                });

                if (!response.ok) {
                    const errData = await response.json();
                    throw new Error(errData.error?.message || 'خطا در ارتباط با سرور گوگل');
                }

                const data = await response.json();
                let aiText = data.candidates[0].content.parts[0].text;
                
                aiText = aiText.replace(/```json/g, '').replace(/```/g, '').trim();
                const slidesData = JSON.parse(aiText);

                statusText.textContent = 'محتوا تولید شد! در حال ساخت فایل پاورپوینت... ⏳';

                let pptx = new PptxGenJS();
                pptx.layout = 'LAYOUT_16x9';

                // تعریف رنگ‌بندی‌ها به همراه متغیر اصلاح‌شده accentColor
                let bgCol = "0F172A", textCol = "F1F5F9", accentCol = "818CF8", cardBg = "1E293B", mutedCol = "94A3B8";
                if (themeStyle === 'light') {
                    bgCol = "F8FAFC"; textCol = "0F172A"; accentCol = "4F46E5"; cardBg = "FFFFFF"; mutedCol = "64748B";
                } else if (themeStyle === 'colorful') {
                    bgCol = "1E1B4B"; textCol = "FFFFFF"; accentCol = "C084FC"; cardBg = "312E81"; mutedCol = "CBD5E1";
                }

                // اسلاید عنوان
                let slide1 = pptx.addSlide();
                slide1.background = { color: bgCol };
                slide1.addShape(pptx.shapes.RECTANGLE, { x: 0.8, y: 1.2, w: 0.15, h: 2.8, fill: { color: accentColor } });
                slide1.addText(topic, { x: 1.2, y: 1.2, w: '80%', h: 2, fontSize: 32, bold: true, color: textCol, fontFace: "Vazirmatn", valign: "middle" });
                slide1.addText("تولید شده هوشمند توسط سامانه گافا (Gafa AI)", { x: 1.2, y: 4.2, w: '80%', h: 0.8, fontSize: 13, color: mutedCol, fontFace: "Vazirmatn" });

                // اسلایدهای هوش مصنوعی
                slidesData.forEach((slideInfo, index) => {
                    let slide = pptx.addSlide();
                    slide.background = { color: bgCol };

                    slide.addText(`بخش ${index + 1}: ${slideInfo.title}`, { x: 0.8, y: 0.6, w: '85%', h: 0.6, fontSize: 20, bold: true, color: accentColor, fontFace: "Vazirmatn" });
                    slide.addShape(pptx.shapes.RECTANGLE, { x: 0.8, y: 1.3, w: '85%', h: 0.02, fill: { color: accentColor } });

                    slide.addShape(pptx.shapes.ROUNDED_RECTANGLE, { x: 0.8, y: 1.6, w: '85%', h: 0.9, fill: { color: cardBg }, line: { color: accentColor, width: 0.5 } });
                    slide.addText(slideInfo.subtitle, { x: 1.0, y: 1.7, w: '81%', h: 0.7, fontSize: 14, color: textCol, fontFace: "Vazirmatn", valign: "middle" });

                    let boxY = 2.7;
                    slideInfo.points.forEach((point, pIdx) => {
                        slide.addShape(pptx.shapes.ROUNDED_RECTANGLE, { x: 0.8, y: boxY, w: '85%', h: 0.75, fill: { color: cardBg }, line: { color: mutedCol, width: 0.3 } });
                        slide.addText(`🔹 ${point}`, { x: 1.0, y: boxY + 0.05, w: '81%', h: 0.65, fontSize: 13, color: textCol, fontFace: "Vazirmatn", valign: "middle" });
                        boxY += 0.9;
                    });

                    slide.addText(`سامانه گافا (Gafa AI) | موضوع: ${topic}`, { x: 0.8, y: 6.8, w: '85%', h: 0.3, fontSize: 9, color: mutedCol, fontFace: "Vazirmatn" });
                });

                pptx.writeFile({ fileName: `Gafa-AI-${topic.replace(/\s+/g, '-')}.pptx` });
                statusText.textContent = 'پاورپوینت هوشمند با موفقیت ساخته شد! 🎉';

            } catch (error) {
                console.error("خطای جزئی:", error);
                statusText.textContent = 'خطا در ارتباط با هوش مصنوعی!';
                alert('خطا: ' + error.message);
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
